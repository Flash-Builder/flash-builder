out us","intro":"The people behind Crumb & Crust Bakery.","text":"Crumb & Crust started in a home kitchen with one sourdough starter and a borrowed oven.\n\nToday we bake every loaf and pastry on Main Street, starting at 4 in the morning, with flour from a mill two hours away.\n\n## What we care about\n\n- Long, slow fermentation\n- Local flour and butter\n- Nothing left over: day-old bread goes to the food bank","slug":"about-us","file":"about-us.html"},{"id":"p4","type":"gallery","title":"Gallery","intro":"A look inside Crumb & Crust Bakery.","slug":"gallery","file":"gallery.html"},{"id":"p5","type":"contact","title":"Contact","intro":"Call, message or visit Crumb & Crust Bakery. We'd love to hear from you.","slug":"contact","file":"contact.html"}],"currency":"$","heroMode":"photo","photoSource":"stock","reviews":[{"text":"Great experience with catering. Easy to reach by phone and no surprises.","name":"Example customer","stars":5,"example":true},{"text":"We've been back a few times now. Consistent every visit and good people to deal with.","name":"Example customer","stars":5,"example":true},{"text":"Called on a busy week and they still fit me in. Really happy with how the fresh bread turned out.","name":"Example customer","stars":5,"example":true}],"reviewsMode":"example","cta":"Order ahead","form":{"title":"Order ahead","intro":"Cakes, big orders and trays: tell us what you'd like and when.","fields":[{"type":"select","label":"What would you like?","options":["Celebration cake","Bread & pastries","Catering tray","Something else"],"required":true},{"type":"date","label":"Pickup date","required":true},{"type":"number","label":"How many people?","min":1,"placeholder":"e.g. 12"},{"type":"text","label":"Allergies or dietary needs","placeholder":"Nut-free, vegan, gluten-free…"}],"message":"Flavors, decorations or message on the cake","submit":"Send my order request"},"logo":null,"studio":"Your Studio"},"autoPalette":{"name":"Forest","bg":"#F5F6F2","surface":"#FFFFFF",